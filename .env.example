# Example environment variables for Rinny Shop
# Copy to .env and fill the values before running

# Discord OAuth2 app credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Session secret - change to a long random string in production
# Generate: openssl rand -base64 32 (Mac/Linux) or use https://www.uuidgenerator.net/
SESSION_SECRET=change-this-to-a-long-random-string

# Comma-separated Discord user IDs that are admins
ADMIN_DISCORD_IDS=

# Optional: invite link to your shop Discord server
SHOP_DISCORD_INVITE=

# Server port (optional)
PORT=3000

# Node environment
NODE_ENV=development

# Optional default permissions bitfield for bot invites
DISCORD_BOT_PERMISSIONS=0
