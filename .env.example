# Example environment variables for Rinny Shop
# Copy to .env and fill the values before running

# Discord OAuth2 app
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Session secret - change to a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Comma-separated Discord user IDs that are admins
ADMIN_DISCORD_IDS=1533794186241773775

# Optional: invite link to your shop Discord
SHOP_DISCORD_INVITE=

# Port (optional)
PORT=3000
